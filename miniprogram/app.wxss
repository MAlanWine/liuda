page { background: #f7f5ef; color: #203b33; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
view, text, button, input, textarea { box-sizing: border-box; }
.page { padding: 34rpx 32rpx 64rpx; }
.eyebrow { color: #6b7d71; font-size: 22rpx; letter-spacing: 4rpx; }
.title { display: block; font-size: 56rpx; font-weight: 700; line-height: 1.3; margin: 18rpx 0; }
.subtitle { color: #6b7d71; font-size: 27rpx; line-height: 1.8; }
.notice { padding: 20rpx 24rpx; background: #eee8d8; border-radius: 18rpx; color: #75623f; font-size: 23rpx; line-height: 1.7; margin: 24rpx 0; }
.card { background: #fffef9; border: 1rpx solid #e2e5d8; border-radius: 26rpx; padding: 28rpx; margin-top: 22rpx; }
.card-title { font-size: 32rpx; font-weight: 600; }
.muted { color: #7c887c; font-size: 24rpx; line-height: 1.7; }
.body { display: block; color: #334d42; font-size: 30rpx; line-height: 1.9; margin: 22rpx 0; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.badge { display: inline-block; padding: 8rpx 16rpx; background: #eaf0df; color: #506343; border-radius: 20rpx; font-size: 21rpx; }
button { border-radius: 20rpx; font-size: 28rpx; font-weight: 500; line-height: 92rpx; margin-top: 24rpx; background: #204e3b; color: #fff; }
button::after { border: 0; }
button.secondary { background: #e7ecdf; color: #294f3d; }
button[disabled] { background: #e0e2d8 !important; color: #909789 !important; }
textarea { width: 100%; min-height: 240rpx; padding: 24rpx; border-radius: 20rpx; background: #fffef9; font-size: 30rpx; line-height: 1.8; margin: 24rpx 0 12rpx; }
.section-label { display: block; font-size: 27rpx; font-weight: 600; margin-top: 36rpx; }
.footer { display: block; margin-top: 30rpx; color: #84907f; font-size: 23rpx; line-height: 1.8; text-align: center; }
