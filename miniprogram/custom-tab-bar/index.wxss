.tabbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1000; background-color: #08090b; border-top: 1px solid #272a31; box-sizing: border-box; }
.tab-items { height: 62px; display: flex; align-items: center; }
.tab-item { flex: 1; height: 62px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #989da8; box-sizing: border-box; }
.tab-active { color: #f3f4f6; }
.tab-label { height: 17px; line-height: 17px; margin-top: 4px; font-size: 11px; text-align: center; }
.compass-icon { width: 22px; height: 22px; border: 1.5px solid #989da8; border-radius: 50%; box-sizing: border-box; }
.compass-needle { font-size: 18px; line-height: 19px; height: 19px; text-align: center; }
.tab-active .compass-icon { border-color: #f3f4f6; }
.plus-icon { width: 46px; height: 30px; border-radius: 12px; background-color: #f0f1f3; color: #121316; font-size: 26px; line-height: 28px; text-align: center; }
.chat-icon { width: 24px; height: 21px; border: 1.5px solid #989da8; border-radius: 8px 8px 8px 2px; font-size: 19px; line-height: 12px; text-align: center; box-sizing: border-box; }
.tab-active .chat-icon { border-color: #f3f4f6; }
