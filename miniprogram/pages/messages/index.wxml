<view class="page">
  <view class="row"><view class="brand-row"><image class="brand-avatar" src="/assets/brand/liuda-comma.png" mode="aspectFit" aria-label="留答" /><text class="title">路过的痕迹</text></view><button class="text-button" bindtap="load" loading="{{loading}}" disabled="{{loading}}">刷新</button></view>
  <view class="row history-meta"><text class="muted">留下 {{posts.length}} 条 · {{mode === 'demo' ? '本机接上' : '近期回应'}} {{replies}} 句</text><text class="badge">{{mode === 'demo' ? '演示' : '现场'}}</text></view>
  <view class="history-tabs"><button class="history-tab {{section === 'mine' ? 'history-tab-active' : ''}}" data-section="mine" bindtap="switchSection">我留下的 {{posts.length}}</button><button class="history-tab {{section === 'replies' ? 'history-tab-active' : ''}}" data-section="replies" bindtap="switchSection">回应 {{events.length}}</button></view>
  <view wx:if="{{error}}" class="card message-status"><text class="card-title">暂未刷新</text><text class="muted">{{error}}</text><button wx:if="{{needsJoin}}" class="secondary" bindtap="connect">加入现场留话</button><button wx:else class="secondary" bindtap="load" disabled="{{loading}}">重试</button></view>
  <block wx:if="{{section === 'mine'}}">
    <view wx:for="{{posts}}" wx:key="id" class="card local-post" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="card-title">{{item.name}}</text><text class="muted">→</text></view><text wx:if="{{mode === 'demo'}}" class="body">{{item.teaser}}</text><view class="row post-foot"><text class="muted">{{item.commentCount}} 句回复 · {{mode === 'demo' ? '演示区' : '走近后查看'}}</text><text class="muted">{{item.timeLabel}}</text></view></view>
    <view wx:if="{{!posts.length && !error}}" class="card message-status empty-message"><image class="empty-mascot" src="/assets/brand/liuda-comma.png" mode="aspectFit" /><text class="card-title">{{loading ? '正在找你的留话…' : '把第一句话留在这里'}}</text><text class="muted">给眼前的地点留个提醒、问题或玩笑。</text><button wx:if="{{!loading}}" class="primary" bindtap="compose">去留一句</button></view>
  </block>
  <block wx:else>
    <view wx:for="{{events}}" wx:key="id" class="card local-post" data-id="{{item.postId}}" bindtap="open"><text class="card-title">有人在现场接了一句</text><view class="row post-foot"><text class="muted">{{item.name}} →</text><text class="muted">{{item.timeLabel}}</text></view></view>
    <view wx:if="{{!events.length && !error}}" class="card message-status empty-message"><image class="empty-mascot" src="/assets/brand/liuda-comma.png" mode="aspectFit" /><text class="card-title">{{loading ? '正在同步…' : '等一个路过的回应'}}</text><text class="muted">{{mode === 'demo' ? '演示区的接话可在地点对话中查看。' : '其他人在你的留话下接话后，会出现在这里。'}}</text><button wx:if="{{!loading}}" class="secondary" bindtap="nearby">去附近看看</button></view>
  </block>
  <button class="text-button" bindtap="about">关于留答</button>
</view>
